# The versions that tools/linux-image/build.sh builds. To upgrade, change a line and run the
# script again.

# The Linux kernel: any release from https://www.kernel.org (6.18 or newer, because the C library
# of the guest is built against the 6.18 kernel headers).
LINUX_VERSION=7.3.4

# Buildroot, the distribution that builds the cross compiler, BusyBox and the root file system
# (https://buildroot.org/download.html). The checksum is in the signed
# buildroot-<version>.tar.xz.sign file next to the download.
BUILDROOT_VERSION=2026.08.1
BUILDROOT_SHA256=34fb7bea8a213ffde39cc02e61703391560f26e0850f03138c722d0b09880f2b
