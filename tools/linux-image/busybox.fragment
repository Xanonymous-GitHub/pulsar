# Applied on top of mini-rv32ima's BusyBox configuration (see build.sh): a smaller BusyBox.
#
# On a no-MMU kernel every running program is loaded whole into one contiguous block of RAM whose
# size is rounded up to a power of two. The stock BusyBox needs a 1 MiB block per process, and the
# machine has 8 MiB in all. This drops what a serial console on a machine without network or disk
# does not need, to get under the next step.

# Archives, checksums, text tools
# CONFIG_ZCAT is not set
# CONFIG_UNZIP is not set
# CONFIG_CKSUM is not set
# CONFIG_CRC32 is not set
# CONFIG_MD5SUM is not set
# CONFIG_SHA1SUM is not set
# CONFIG_BASE64 is not set
# CONFIG_EXPR is not set
# CONFIG_FACTOR is not set
# CONFIG_OD is not set
# CONFIG_PASTE is not set
# CONFIG_SEQ is not set
# CONFIG_SORT is not set
# CONFIG_TSORT is not set
# CONFIG_UNIQ is not set
# CONFIG_TEE is not set
# CONFIG_SED is not set
# CONFIG_XARGS is not set
# CONFIG_XXD is not set
# CONFIG_ASCII is not set
# CONFIG_TREE is not set
# CONFIG_TS is not set
# CONFIG_MORE is not set
# CONFIG_YES is not set

# Files and devices that are of no use here
# CONFIG_CHROOT is not set
# CONFIG_CHGRP is not set
# CONFIG_CHOWN is not set
# CONFIG_DD is not set
# CONFIG_DU is not set
# CONFIG_LINK is not set
# CONFIG_UNLINK is not set
# CONFIG_MKFIFO is not set
# CONFIG_MKNOD is not set
# CONFIG_READLINK is not set
# CONFIG_REALPATH is not set
# CONFIG_TRUNCATE is not set
# CONFIG_TTY is not set
# CONFIG_USLEEP is not set
# CONFIG_LINUX32 is not set
# CONFIG_LINUXRC is not set

# One user, one console: no login, no accounting
# CONFIG_GETTY is not set
# CONFIG_LOGIN is not set
# CONFIG_HOSTID is not set
# CONFIG_ID is not set
# CONFIG_WHO is not set
# CONFIG_W is not set
# CONFIG_MESG is not set
# CONFIG_NICE is not set
# CONFIG_NOHUP is not set
# CONFIG_NPROC is not set
# CONFIG_LSOF is not set
# CONFIG_PKILL is not set
# CONFIG_WATCH is not set

# The shell keeps conditions, loops and job control, and loses the rest
# CONFIG_HUSH_BASH_COMPAT is not set
# CONFIG_HUSH_BRACE_EXPANSION is not set
# CONFIG_HUSH_LINENO_VAR is not set
# CONFIG_HUSH_SAVEHISTORY is not set
# CONFIG_HUSH_RANDOM_SUPPORT is not set
# CONFIG_HUSH_MODE_X is not set
# CONFIG_HUSH_GETOPTS is not set
# CONFIG_HUSH_ULIMIT is not set
# CONFIG_HUSH_TIMES is not set
# CONFIG_HUSH_FUNCTIONS is not set
# CONFIG_HUSH_LOCAL is not set
# CONFIG_HUSH_TRAP is not set
# CONFIG_HUSH_TYPE is not set
# CONFIG_HUSH_UMASK is not set
