# Kernel configuration of the Linux guest: everything that is not listed keeps the kernel's
# default. The machine is the one in src/linux/machine.rs.

# The processor: RV32IMA in machine mode, no MMU, no compressed instructions, no floating point.
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_MMU is not set
CONFIG_RISCV_M_MODE=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_FPU is not set
# CONFIG_SMP is not set
CONFIG_HZ_100=y

# Programs are "flat" binaries, and the root file system is in the kernel image (Buildroot fills
# in its path).
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# The devices: an 8250 serial port found through the device tree, and the power switch.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set

# 8 MiB of RAM: a small kernel. No network, no disks, no modules.
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB_TINY=y
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_MODULES is not set
# CONFIG_KALLSYMS is not set
# CONFIG_SWAP is not set
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_FHANDLE is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_DNOTIFY is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_COREDUMP is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HWMON is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_EFI is not set
# CONFIG_SUSPEND is not set
# CONFIG_CRYPTO is not set

# What a shell needs from the kernel.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
