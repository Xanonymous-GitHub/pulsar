# Kernel configuration of the Linux guest: everything that is not listed keeps the kernel's
# default. The machine is the one in src/linux/machine.rs.

# The processor: RV32IMA in machine mode, no MMU, no compressed instructions, no floating point.
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_MMU is not set
CONFIG_RISCV_M_MODE=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_FPU is not set
# CONFIG_SMP is not set
CONFIG_HZ_100=y

# Programs are "flat" binaries, and the root file system is in the kernel image (Buildroot fills
# in its path).
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# The devices: an 8250 serial port found through the device tree, and the power switch.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
# CONFIG_VT is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set

# 8 MiB of RAM: a small kernel. No network, no disks, no modules, none of the system calls and
# subsystems that a BusyBox shell does not use, and none of the optional instruction-set
# extensions (the processor has none of them).
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
CONFIG_PREEMPT_NONE=y
# The kernel's message buffer: 16 KiB instead of 128 KiB.
CONFIG_LOG_BUF_SHIFT=14
# Unaligned loads and stores cost the same as aligned ones here: do not measure it at boot.
CONFIG_RISCV_EFFICIENT_UNALIGNED_ACCESS=y
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_MODULES is not set
# CONFIG_KALLSYMS is not set
# CONFIG_SWAP is not set
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_FHANDLE is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_DNOTIFY is not set
# CONFIG_FILE_LOCKING is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_EVENTFD is not set
# CONFIG_SHMEM is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_RSEQ is not set
# CONFIG_KCMP is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_UID16 is not set
# CONFIG_SGETMASK_SYSCALL is not set
# CONFIG_ELF_CORE is not set
# CONFIG_COREDUMP is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SECCOMP is not set
# CONFIG_SECURITY is not set
# CONFIG_AUDIT is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_JUMP_LABEL is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_COMPACTION is not set
# CONFIG_MIGRATION is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_MISC_FILESYSTEMS is not set
# CONFIG_NLS is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_PCI is not set
# CONFIG_EFI is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_RELOCATABLE is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HWMON is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_DEVMEM is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_CRYPTO is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_VENDOR_EXT is not set

# What a shell needs from the kernel.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
