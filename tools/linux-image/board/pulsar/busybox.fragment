# Applied on top of Buildroot's busybox-minimal.config (its configuration for machines without
# MMU): a smaller BusyBox for a serial console on a machine with 8 MiB, no network and no disk.
#
# Size matters twice here. A no-MMU kernel loads every running program whole into one contiguous
# block of RAM, rounded up to a power of two. And the shell runs the small applets inside its
# own process ("nofork") instead of loading BusyBox once more for each command.
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y

# Added: a look at the machine.
CONFIG_FREE=y
CONFIG_UPTIME=y

