# ESP-IDF settings for development builds. Picked up through ESP_IDF_SDKCONFIG_DEFAULTS in
# .cargo/config.toml. Security features that burn eFuses (flash encryption, secure boot) are NOT
# here on purpose: see sdkconfig.defaults.secure and docs/secure-wifi-secrets.md.

# The partition table is NOT set here: esp-idf-sys would not use it. partitions.csv is applied when
# flashing (`espflash flash --partition-table partitions.csv`, see the runner in .cargo/config.toml).

# Smaller binary.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Rust's std needs a bigger main task stack than the 3.5 KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# 1 ms tick, so std::thread::sleep is accurate.
CONFIG_FREERTOS_HZ=1000

# TLS 1.3 for HTTPS. TLS 1.2 stays enabled as a fallback for servers without 1.3.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# Allocate the TLS record buffers only while data is in flight, and free handshake-only data when
# the handshake is over. Without this every TLS session keeps about 20 KB resident, and an
# MQTT-over-TLS connection (src/mqtt/, always on) next to the weather requests does not fit in the
# ~80 KB of heap that is free with Wi-Fi and Bluetooth running.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# The largest TLS record accepted is 8 KiB instead of 16 KiB: even with dynamic buffers one block of
# that size must be free for every record, and the heap is too fragmented to have a 16 KiB one while
# Wi-Fi, Bluetooth and MQTT run. A server that sends a longer record (a big message or a very long
# certificate chain) fails the handshake or the connection; `config::MQTT_MAX_INCOMING_BYTES` keeps
# MQTT inside this limit.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

# Check the validity dates of certificates (off by default in mbedTLS). The clock must be right
# first: src/clock.rs sets it with SNTP, and src/http.rs waits for it before every HTTPS request.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Bluetooth LE through NimBLE (src/bluetooth/, docs/bluetooth.md). Bluedroid is not used.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Bonding keys go to the encrypted secret store (src/bluetooth/bonds.rs). NimBLE's own NVS
# persistence would write them in plain text to the `nvs` partition, which flash encryption does
# not cover. Never turn this on.
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# LE Secure Connections only (Bluetooth 4.2): no legacy pairing. A phone that re-pairs after a
# lost bond replaces the old one instead of being refused.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y

# Bluetooth 5: extended advertising (two sets: legacy and LE Coded), extended scanning. 2M and
# Coded PHY are on by default. Periodic advertising and sync have no user here and cost RAM.
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=251
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=n
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=n

CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="pulsar"
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7000

# Keep NimBLE quiet: its debug output can include key material.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# MQTT (src/mqtt/). The client is the managed component `espressif/mqtt`, see Cargo.toml.
# MQTT 5.0 on top of 3.1.1 (`config::MQTT_PROTOCOL_V5` picks the one used).
CONFIG_MQTT_PROTOCOL_5=y
# Transports: mqtt:// (TCP), mqtts:// (TLS), ws:// and wss:// (WebSocket, plain and over TLS).
# Server certificates are checked against the built-in Mozilla bundle, as for HTTPS.
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y
